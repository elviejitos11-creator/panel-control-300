'use strict';

const crypto = require('crypto');
const fs = require('fs');
const path = require('path');

module.exports = function instalarCQ(app, funciones) {
  const {
    leerData,
    borrarPerfil
  } = funciones;

  const privateDir = process.env.CQ_DATA_DIR
    ? path.resolve(process.env.CQ_DATA_DIR)
    : path.join(__dirname, 'cq_private');
  const usersFile = path.join(privateDir, 'usuarios.json');
  const ownersFile = path.join(privateDir, 'propietarios.json');
  const secretFile = path.join(privateDir, 'sesion.key');

  fs.mkdirSync(privateDir, { recursive: true });

  function leer(file, fallback) {
    if (!fs.existsSync(file)) return fallback;
    return JSON.parse(fs.readFileSync(file, 'utf8'));
  }

  function guardar(file, objeto) {
    const temp = file + '.tmp';
    fs.writeFileSync(temp, JSON.stringify(objeto, null, 2));
    fs.renameSync(temp, file);
  }

  if (!fs.existsSync(secretFile)) {
    fs.writeFileSync(secretFile, crypto.randomBytes(48).toString('hex'));
  }

  const secret = fs.readFileSync(secretFile, 'utf8').trim();

  function usuarios() {
    return leer(usersFile, { items: {} });
  }

  function propietarios() {
    return leer(ownersFile, { items: {} });
  }

  function esc(valor) {
    return String(valor == null ? '' : valor)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function hashPassword(password, salt) {
    return crypto.pbkdf2Sync(password, salt, 210000, 32, 'sha256')
      .toString('hex');
  }

  function crearCredencial(password) {
    const salt = crypto.randomBytes(24).toString('hex');
    return { salt, hash: hashPassword(password, salt) };
  }

  function comprobarCredencial(password, usuario) {
    if (!usuario || !usuario.salt || !usuario.hash) return false;

    const calculado = Buffer.from(
      hashPassword(password, usuario.salt), 'hex'
    );
    const original = Buffer.from(usuario.hash, 'hex');

    return calculado.length === original.length &&
      crypto.timingSafeEqual(calculado, original);
  }

  function firmar(payload) {
    const body = Buffer.from(JSON.stringify(payload))
      .toString('base64url');

    const sig = crypto.createHmac('sha256', secret)
      .update(body).digest('base64url');

    return body + '.' + sig;
  }

  function verificar(valor) {
    try {
      const partes = String(valor || '').split('.');
      if (partes.length !== 2) return null;

      const esperado = crypto.createHmac('sha256', secret)
        .update(partes[0]).digest('base64url');

      const a = Buffer.from(esperado);
      const b = Buffer.from(partes[1]);

      if (a.length !== b.length ||
          !crypto.timingSafeEqual(a, b)) return null;

      const obj = JSON.parse(
        Buffer.from(partes[0], 'base64url').toString('utf8')
      );

      if (!obj.exp || Date.now() > obj.exp) return null;
      return obj;
    } catch {
      return null;
    }
  }

  function cookies(req) {
    const out = {};
    String(req.headers.cookie || '').split(';').forEach(parte => {
      const i = parte.indexOf('=');
      if (i > 0) {
        out[parte.slice(0, i).trim()] =
          parte.slice(i + 1).trim();
      }
    });
    return out;
  }

  function ponerSesion(res, obj) {
    res.setHeader('Set-Cookie',
      'cq_session=' + firmar({
        ...obj,
        exp: Date.now() + 12 * 60 * 60 * 1000
      }) + '; HttpOnly; SameSite=Lax; Path=/; Max-Age=43200'
    );
  }

  // CQ_CACHE_PRIVADO_V1
  app.use((req, res, next) => {
    res.setHeader('Cache-Control', 'no-store, no-cache, must-revalidate, private');
    res.setHeader('Pragma', 'no-cache');
    res.setHeader('Expires', '0');
    next();
  });
  function enviarPagina(res, titulo, contenido) {
    res.send(`<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>${esc(titulo)}</title>
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
<link rel="icon" type="image/png" href="/icons/postbot-icono.png">
<style>
*{box-sizing:border-box}
body{margin:0;padding:20px;font:16px Arial;background:#0b1c2c;color:white}
main{max-width:820px;margin:25px auto;background:#132f4c;padding:24px;border-radius:16px}
input{width:100%;padding:12px;margin:8px 0 16px;border:1px solid #486482;background:#071829;color:white;border-radius:9px}
button,.btn{display:inline-block;background:#1976d2;color:white;border:0;padding:11px 15px;margin:5px;border-radius:9px;cursor:pointer;text-decoration:none}
.danger{background:#b32626}.green{background:#297c46}
.card{padding:14px;margin:12px 0;background:#0d243c;border-radius:12px}
small{color:#bdcbd8}
</style>
</head>
<body><main>${contenido}</main></body>
</html>`);
  }

  function identidad(req) {
    const token = verificar(cookies(req).cq_session);
    if (!token) return null;

    const db = usuarios();
    const usuario = db.items[token.uid];

    if (!usuario || usuario.suspendido) return null;
    if (usuario.rol === 'cliente' && usuario.venceEn) {
      const vencimiento = Date.parse(usuario.venceEn);
      if (!Number.isFinite(vencimiento) ||
          Date.now() > vencimiento) return null;
    }
    if (usuario.version !== token.version) return null;

    return {
      id: token.uid,
      usuario,
      admin: usuario.rol === 'admin',
      vista: token.vista || ''
    };
  }

  function duenoPerfil(id) {
    const mapa = propietarios();
    return mapa.items[String(id)] || 'admin';
  }

  function puedeVer(req, id) {
    if (!req.cq) return false;

    const dueño = duenoPerfil(id);
    const vista = req.cq.admin
      ? (req.cq.vista || 'admin')
      : req.cq.id;

    return dueño === vista;
  }

  function alcance(req) {
    return req.cq.admin
      ? (req.cq.vista || 'admin')
      : req.cq.id;
  }

  function filtrarData(req, data) {
    const resultado = {};
    for (const [id, p] of Object.entries(data)) {
      if (puedeVer(req, id)) resultado[id] = p;
    }
    return resultado;
  }

  function registrarPropietario(req, id) {
    const mapa = propietarios();
    mapa.items[String(id)] = alcance(req);
    guardar(ownersFile, mapa);
  }

  function quitarPropietario(id) {
    const mapa = propietarios();
    delete mapa.items[String(id)];
    guardar(ownersFile, mapa);
  }

  function respaldoBorrado(id) {
    const dir = path.join(privateDir, 'respaldos');
    fs.mkdirSync(dir, { recursive: true });

    const nombre = Date.now() + '-' +
      String(id).replace(/[^a-zA-Z0-9_-]/g, '_');

    const mapa = {
      perfil: leerData()[id],
      propietario: duenoPerfil(id),
      guardado: new Date().toISOString()
    };

    fs.writeFileSync(
      path.join(dir, nombre + '.json'),
      JSON.stringify(mapa, null, 2)
    );
  }

  // Inicializar administrador una sola vez desde variables
  // de entorno, sin guardar contraseñas en el código.
  const dbInicial = usuarios();

  if (!dbInicial.items.admin &&
      process.env.CQ_ADMIN_PASSWORD &&
      process.env.CQ_ADMIN_PASSWORD.length >= 12) {

    dbInicial.items.admin = {
      nombre: process.env.CQ_ADMIN_USER || 'admin',
      rol: 'admin',
      suspendido: false,
      version: 1,
      ...crearCredencial(process.env.CQ_ADMIN_PASSWORD)
    };

    guardar(usersFile, dbInicial);
  }

  app.get('/login', (req, res) => {
    enviarPagina(res, 'Acceso privado', `
      <div style="text-align:center;margin-bottom:16px">
<img src="/icons/postbot-icono.png" alt="POSTBOT TELEGRAM"
style="width:150px;height:150px;object-fit:contain;border-radius:24px">
</div>
<h1 style="text-align:center">
<span style="font-size:1.65em">🐺</span>
PANEL PRO
<span style="font-size:1.65em">🐺</span>
</h1>
      <h3 style="text-align:center">ACCESO PRIVADO</h3>
      <form method="post" action="/login">
        <label>Usuario</label>
        <input name="usuario" autocomplete="username" required>
        <label>Contraseña</label>
        <input name="password" type="password"
          autocomplete="current-password" required>
        <button type="submit">ENTRAR AL PANEL</button>
      </form>
    `);
  });

  app.post('/login', (req, res) => {
    const nombre = String(req.body.usuario || '').trim();
    const pass = String(req.body.password || '');
    const db = usuarios();

    const encontrado = Object.entries(db.items).find(([id, u]) =>
      u.nombre === nombre && !u.suspendido &&
      comprobarCredencial(pass, u)
    );

    if (!encontrado) {
      return res.status(401).send('Usuario o contraseña incorrectos');
    }

    const [uid, u] = encontrado;

    ponerSesion(res, {
      uid,
      version: u.version,
      vista: ''
    });

    res.redirect('/');
  });

  app.get('/logout', (req, res) => {
    res.setHeader('Set-Cookie',
      'cq_session=; HttpOnly; SameSite=Lax; Path=/; Max-Age=0');
    res.redirect('/login');
  });

  // Autenticación para todas las páginas originales.
  app.use((req, res, next) => {
    const cq = identidad(req);

    if (!cq) {
      if (req.path.startsWith('/api/') ||
          req.path === '/registrar-evento' ||
          req.path === '/registrar-alerta') {
        return next();
      }

      return res.redirect('/login');
    }

    req.cq = cq;
    next();
  });

  // CQ_ADMIN_FUNCIONAL_V3

  function fechaLicencia(u) {
    if (!u.venceEn) return 'Sin vencimiento configurado';
    const fecha = new Date(u.venceEn);
    return Number.isNaN(fecha.getTime())
      ? 'Fecha no disponible'
      : fecha.toLocaleString('es-DO');
  }

  function estiloAdmin() {
    return `
    <style>
      body {
        background:linear-gradient(145deg,#0b1930,#201038);
        min-height:100vh;
        color:#fff;
      }
      main {
        width:min(94%,620px);
        max-width:620px;
        margin:25px auto;
        background:#0e1934;
        border:1px solid #314264;
        border-radius:18px;
        padding:24px;
      }
      h1 {font-size:26px;line-height:1.3}
      h2 {font-size:23px}
      p,.subtitulo {color:#b7c7e1}
      .admin-card {
        background:#142947;
        padding:22px;
        border:1px solid #344566;
        border-radius:16px;
        margin:20px 0;
      }
      .cliente-card {
        background:#091b32;
        border-radius:12px;
        padding:17px;
        margin-top:14px;
        overflow-wrap:anywhere;
      }
      label {
        display:block;
        font-weight:600;
        margin:15px 0 7px;
      }
      input {
        display:block;
        width:100%;
        background:#061428;
        color:#fff;
        border:1px solid #3a4c6b;
        border-radius:9px;
        padding:13px;
        margin:0 0 15px;
      }
      input:focus {
        outline:2px solid #227cfa;
      }
      button,.btn {
        display:inline-block;
        background:linear-gradient(110deg,#087dfa,#b10ddb);
        color:white;
        padding:11px 15px;
        margin:4px 4px 4px 0;
        border:0;
        border-radius:9px;
        font-weight:600;
        text-decoration:none;
        cursor:pointer;
      }
      .danger {background:#bb3030!important}
      .green {
        background:linear-gradient(110deg,#087dfa,#b10ddb)!important;
      }
      .estado {
        font-size:14px;
        line-height:1.6;
        color:#b8c7df;
      }
      form {margin:0}
      .acciones {margin-top:12px}
      .acciones form {display:inline-block}
      .acciones input[type=hidden] {display:none}
      @media(max-width:600px) {
        body {padding:10px}
        main {width:100%;padding:17px;margin:12px auto}
        .admin-card {padding:17px}
        h1 {font-size:23px}
      }
    </style>`;
  }

  // CQ_OCULTAR_ADMIN_CLIENTE_V1
  // La administracion solo se muestra en la vista propia del admin.
  app.use((req, res, next) => {
    if (req.method !== 'GET' || req.path !== '/' || !req.cq) {
      return next();
    }

    const esPanelAdmin = req.cq.admin &&
      (!req.cq.vista || req.cq.vista === 'admin');

    if (esPanelAdmin) return next();

    const enviarOriginal = res.send.bind(res);

    res.send = function(contenido) {
      if (typeof contenido === 'string' &&
          /Administraci[oó]n de clientes/i.test(contenido)) {

        contenido = contenido.replace(
          /<a\b[^>]*>[\s\S]*?<\/a>/gi,
          enlace => {
            const texto = enlace.replace(/<[^>]*>/g, '');

            if (/Administraci[oó]n de clientes/i.test(texto) &&
                /\/admin/i.test(enlace)) {
              return '';
            }

            return enlace;
          }
        );
      }

      return enviarOriginal(contenido);
    };

    next();
  });
  // CQ_OCULTAR_ADMIN_CLIENTE_V1
  // La administracion solo se muestra en la vista propia del admin.
  app.use((req, res, next) => {
    if (req.method !== 'GET' || req.path !== '/' || !req.cq) {
      return next();
    }

    const esPanelAdmin = req.cq.admin &&
      (!req.cq.vista || req.cq.vista === 'admin');

    if (esPanelAdmin) return next();

    const enviarOriginal = res.send.bind(res);

    res.send = function(contenido) {
      if (typeof contenido === 'string' &&
          /Administraci[oó]n de clientes/i.test(contenido)) {

        contenido = contenido.replace(
          /<a\b[^>]*>[\s\S]*?<\/a>/gi,
          enlace => {
            const texto = enlace.replace(/<[^>]*>/g, '');

            if (/Administraci[oó]n de clientes/i.test(texto) &&
                /\/admin/i.test(enlace)) {
              return '';
            }

            return enlace;
          }
        );
      }

      return enviarOriginal(contenido);
    };

    next();
  });
  // CQ_BOTON_SALIR_CLIENTE_V1
  app.use((req, res, next) => {
    if (req.method !== 'GET' || req.path !== '/' || !req.cq) {
      return next();
    }

    const esCliente = !req.cq.admin ||
      (req.cq.vista && req.cq.vista !== 'admin');

    if (!esCliente) return next();

    const enviarOriginal = res.send.bind(res);

    res.send = function(contenido) {
      if (typeof contenido === 'string' &&
          /<\/body>/i.test(contenido)) {

        const boton = `
          <a href="/logout" id="cq-salir-cliente"
             style="position:fixed;top:14px;right:18px;
             z-index:99999;background:#bc3030;color:white;
             text-decoration:none;padding:11px 16px;
             border-radius:9px;font:600 14px Arial;
             box-shadow:0 3px 12px rgba(0,0,0,.3)">
             Cerrar sesi&oacute;n
          </a>`;

        if (!contenido.includes('id="cq-salir-cliente"')) {
          contenido = contenido.replace(/<\/body>/i, boton + '</body>');
        }
      }

      return enviarOriginal(contenido);
    };

    next();
  });
  app.get('/admin', (req, res) => {
    if (!req.cq.admin) return res.sendStatus(403);

    const db = usuarios();

    const cards = Object.entries(db.items)
      .filter(([id]) => id !== 'admin')
      .map(([id, u]) => `
        <div class="cliente-card">
          <strong>${esc(u.nombreCompleto || u.nombre)}</strong>
          <div class="estado">
            ID: ${esc(id)}<br>
            Usuario: ${esc(u.nombre)}<br>
            Estado: ${u.suspendido ? 'SUSPENDIDO' :
              (u.venceEn && Date.now() > Date.parse(u.venceEn)
                ? 'VENCIDO' : 'ACTIVO')}<br>
            Vence: ${esc(fechaLicencia(u))}<br>
            Perfiles permitidos:
            ${esc(u.limitePerfiles == null
              ? 'Sin limite configurado' : u.limitePerfiles)}
          </div>
          <div class="acciones">
            <a class="btn"
               href="/admin/abrir/${encodeURIComponent(id)}">
               Panel
            </a>
            <a class="btn"
               href="/admin/editar/${encodeURIComponent(id)}">
               Editar
            </a>
            <form method="post" action="/admin/suspender">
              <input type="hidden" name="id" value="${esc(id)}">
              <button class="danger" type="submit">
                ${u.suspendido ? 'Reactivar' : 'Suspender'}
              </button>
            </form>
          </div>
        </div>
      `).join('');

    enviarPagina(res, 'PANEL PRO - Administracion', `
      ${estiloAdmin()}

      <a class="btn" href="/admin/abrir/admin">
        Volver a mi trabajo
      </a>


      <h1>PANEL PRO - Administracion</h1>
      <p class="subtitulo">
        Crear y controlar clientes desde tu mismo panel.
      </p>

      <section class="admin-card">
        <h2>+ Crear cliente</h2>

        <form method="post" action="/admin/crear">
          <label>Nombre</label>
          <input name="nombreCompleto"
                 maxlength="100" required>

          <label>Usuario</label>
          <input name="nombre"
                 minlength="3" maxlength="60"
                 autocomplete="off" required>

          <label>Contrase&ntilde;a del cliente</label>
          <input name="password" type="password"
                 minlength="12"
                 autocomplete="new-password" required>

          <label>D&iacute;as de licencia</label>
          <input name="diasLicencia" type="number"
                 min="1" max="3650" value="30" required>

          <label>L&iacute;mite de perfiles</label>
          <input name="limitePerfiles" type="number"
                 min="1" max="10000" value="20" required>

          <button class="green" type="submit">
            + Crear cliente
          </button>
        </form>
      </section>

      <section class="admin-card">
        <h2>Clientes registrados</h2>
        ${cards || '<p>Todavia no hay clientes.</p>'}
      </section>
    `);
  });

  app.post('/admin/crear', (req, res) => {
    if (!req.cq.admin) return res.sendStatus(403);

    const nombreCompleto =
      String(req.body.nombreCompleto || '').trim();
    const nombre = String(req.body.nombre || '').trim();
    const password = String(req.body.password || '');
    const dias = Number(req.body.diasLicencia);
    const limite = Number(req.body.limitePerfiles);

    if (
      nombreCompleto.length < 2 ||
      nombreCompleto.length > 100 ||
      nombre.length < 3 ||
      nombre.length > 60 ||
      password.length < 12 ||
      !Number.isInteger(dias) ||
      dias < 1 || dias > 3650 ||
      !Number.isInteger(limite) ||
      limite < 1 || limite > 10000
    ) {
      return res.status(400).send('Datos de cliente invalidos');
    }

    const db = usuarios();

    if (Object.values(db.items).some(u => u.nombre === nombre)) {
      return res.status(409).send('Usuario existente');
    }

    let id;
    do {
      id = 'cq-' + crypto.randomBytes(8).toString('hex');
    } while (db.items[id]);

    db.items[id] = {
      nombre,
      nombreCompleto,
      rol:'cliente',
      suspendido:false,
      version:1,
      creadoEn:new Date().toISOString(),
      venceEn:new Date(
        Date.now() + dias * 86400000
      ).toISOString(),
      limitePerfiles:limite,
      ...crearCredencial(password)
    };

    guardar(usersFile, db);
    res.redirect('/admin');
  });

  app.get('/admin/editar/:id', (req, res) => {
    if (!req.cq.admin) return res.sendStatus(403);

    const id = String(req.params.id);
    const db = usuarios();
    const u = db.items[id];

    if (id === 'admin' || !u) return res.sendStatus(404);

    const diasRestantes = u.venceEn
      ? Math.max(1, Math.ceil(
          (Date.parse(u.venceEn) - Date.now()) / 86400000
        ) || 1)
      : 30;

    enviarPagina(res, 'Editar cliente', `
      ${estiloAdmin()}

      <a class="btn" href="/admin">
        Volver a administracion
      </a>

      <section class="admin-card">
        <h1>Editar cliente</h1>
        <p>ID: ${esc(id)}</p>

        <form method="post"
              action="/admin/editar/${encodeURIComponent(id)}">

          <label>Nombre</label>
          <input name="nombreCompleto"
                 value="${esc(u.nombreCompleto || u.nombre)}"
                 maxlength="100" required>

          <label>Usuario</label>
          <input name="nombre"
                 value="${esc(u.nombre)}"
                 maxlength="60" required>

          <label>Nueva contrase&ntilde;a (opcional)</label>
          <input name="password"
                 type="password" minlength="12"
                 autocomplete="new-password">
          <small>Dejar vacio para conservar la actual.</small>

          <label>D&iacute;as de licencia desde hoy</label>
          <input name="diasLicencia" type="number"
                 min="1" max="3650"
                 value="${diasRestantes}" required>

          <label>L&iacute;mite de perfiles</label>
          <input name="limitePerfiles" type="number"
                 min="1" max="10000"
                 value="${esc(u.limitePerfiles || 20)}" required>

          <button type="submit">Guardar cambios</button>
        </form>
      </section>
    `);
  });

  app.post('/admin/editar/:id', (req, res) => {
    if (!req.cq.admin) return res.sendStatus(403);

    const id = String(req.params.id);
    const db = usuarios();
    const u = db.items[id];

    if (id === 'admin' || !u) return res.sendStatus(404);

    const nombreCompleto =
      String(req.body.nombreCompleto || '').trim();
    const nombre = String(req.body.nombre || '').trim();
    const password = String(req.body.password || '');
    const dias = Number(req.body.diasLicencia);
    const limite = Number(req.body.limitePerfiles);

    if (
      nombreCompleto.length < 2 ||
      nombreCompleto.length > 100 ||
      nombre.length < 3 ||
      nombre.length > 60 ||
      (password && password.length < 12) ||
      !Number.isInteger(dias) ||
      dias < 1 || dias > 3650 ||
      !Number.isInteger(limite) ||
      limite < 1 || limite > 10000
    ) {
      return res.sendStatus(400);
    }

    if (Object.entries(db.items).some(
      ([otroId, otro]) => otroId !== id && otro.nombre === nombre
    )) {
      return res.status(409).send('Usuario existente');
    }

    u.nombreCompleto = nombreCompleto;
    u.nombre = nombre;
    u.venceEn = new Date(
      Date.now() + dias * 86400000
    ).toISOString();
    u.limitePerfiles = limite;

    if (password) {
      Object.assign(u, crearCredencial(password));
      u.version++;
    }

    guardar(usersFile, db);
    res.redirect('/admin');
  });
  app.post('/admin/eliminar', (req, res) => {
  if (!req.cq.admin) return res.sendStatus(403);

  const id = String(req.body.id || '');
  if (!id || id === 'admin' || !Object.prototype.hasOwnProperty.call(usuarios().items, id)) {
    return res.sendStatus(404);
  }

  const db = usuarios();
  if (!db.items[id]) return res.sendStatus(404);

  const fs = require('fs');
  const copia = usersFile + '.antes-eliminar-' + Date.now();
  fs.copyFileSync(usersFile, copia, fs.constants.COPYFILE_EXCL);

  delete db.items[id];
  guardar(usersFile, db);

  res.redirect('/admin');
});
app.post('/admin/suspender', (req, res) => {
    if (!req.cq.admin) return res.sendStatus(403);

    const id = String(req.body.id || '');
    if (id === 'admin') return res.sendStatus(403);

    const db = usuarios();
    if (!db.items[id]) return res.sendStatus(404);

    db.items[id].suspendido = !db.items[id].suspendido;
    db.items[id].version++;
    guardar(usersFile, db);

    res.redirect('/admin');
  });

  app.get('/admin/abrir/:id', (req, res) => {
    if (!req.cq.admin) return res.sendStatus(403);

    const id = String(req.params.id);
    const db = usuarios();

    if (id !== 'admin' && !db.items[id]) {
      return res.sendStatus(404);
    }

    ponerSesion(res, {
      uid: req.cq.id,
      version: req.cq.usuario.version,
      vista: id
    });

    res.redirect('/');
  });

  // Protección contra solicitudes web externas.
  app.use((req, res, next) => {
    if (!['POST', 'PUT', 'PATCH', 'DELETE'].includes(req.method)) {
      return next();
    }

    if (!req.cq) return next();

    const origen = req.get('origin');

    if (origen) {
      try {
        const url = new URL(origen);
        const host = req.get('host');

        if (url.host !== host ||
            !['https:', 'http:'].includes(url.protocol)) {
          return res.sendStatus(403);
        }
      } catch {
        return res.sendStatus(403);
      }
    }

    if (req.get('sec-fetch-site') === 'cross-site') {
      return res.sendStatus(403);
    }

    return next();
  });

  // Comprobar autorizaciones antes de las rutas originales.
  app.use((req, res, next) => {
    const ruta = req.path;

    if (ruta === '/' ||
        ruta === '/nuevo' ||
        ruta === '/guardar-perfil' ||
        ruta === '/accion' ||
        ruta === '/accion-global' ||
        ruta.startsWith('/editar/')) {

      if (!req.cq) return res.sendStatus(401);
    }

    if (ruta.startsWith('/editar/')) {
      if (!puedeVer(req, req.params?.id || ruta.slice(8))) {
        return res.sendStatus(403);
      }
    }

    if (ruta === '/accion') {
      const id = String(req.body.id || '');
      if (!puedeVer(req, id)) return res.sendStatus(403);
    }

    if (ruta === '/guardar-perfil') {
      const id = String(req.body.id || '').trim();

      if (!/^[A-Za-z0-9_-]{1,50}$/.test(id)) {
        return res.sendStatus(400);
      }

      const data = leerData();

      if (Object.prototype.hasOwnProperty.call(data, id) &&
          !puedeVer(req, id)) {
        return res.sendStatus(403);
      }
    }

    next();
  });

  return {
    filtrarData,
    registrarPropietario,
    quitarPropietario,
    puedeVer,
    alcance,
    respaldoBorrado,
    borrarPerfil
  };
};